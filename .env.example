# Copy to .env.local and fill in. Never commit real values.

# Supabase Postgres. Server only.
# Transaction pooler, port 6543. postgres.js must use prepare:false with this.
DATABASE_URL=
# Direct connection, port 5432. Migrations only.
DATABASE_URL_DIRECT=

SUPABASE_URL=
# Server-only. Never exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# openssl rand -hex 32 — salts the device and IP hashes.
SERVER_SALT=
# openssl rand -hex 32 — guards the internal ingest routes.
INGEST_SECRET=

# Cloudflare Turnstile.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GA4. Loads only after consent. Optional.
NEXT_PUBLIC_GA_ID=

# Comma-separated allowlist for the moderation queue.
ADMIN_EMAILS=
