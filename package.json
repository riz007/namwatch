{
  "name": "namwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "check:cvd": "tsx scripts/check-cvd.ts",
    "db:generate": "drizzle-kit generate && tsx scripts/fix-postgis-types.ts",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "ingest:local": "tsx --conditions=react-server scripts/ingest-local.ts",
    "tokens:generate": "tsx scripts/generate-tokens.ts",
    "sync:map-worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/",
    "postinstall": "pnpm sync:map-worker",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "ingest:live": "tsx --conditions=react-server scripts/ingest-live.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "h3-js": "4.5.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "supercluster": "9.1.0",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supercluster": "7.1.3",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
